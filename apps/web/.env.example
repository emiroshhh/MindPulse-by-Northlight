# All values are server-only. Never prefix with NEXT_PUBLIC_ and never commit
# real values. In production these live as Cloudflare Worker secrets.

# AI provider (Gemini is the default).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional alternative provider. Only used when AI_PROVIDER=deepseek.
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# Session signing secret. Required for auth; must be at least 32 characters.
SESSION_SECRET=generate_a_random_string_of_at_least_32_chars

# Opt-in unauthenticated boolean-only auth diagnostics at /api/auth/debug.
# Leave unset in production.
# AUTH_DEBUG=true
