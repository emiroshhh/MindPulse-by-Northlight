# Server-only. Never expose these values in frontend code or commits.
# See apps/web/.env.example for the full annotated list.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Normal Worker variables (not secrets). Set false to disable provider calls.
AI_ENABLED=true
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_MONTHLY_LIMIT=1000
# Canonical HTTPS production origin, without a trailing slash.
SITE_URL=https://mindpulse.example
SESSION_SECRET=generate_a_random_string_of_at_least_32_chars
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
# AUTH_DEBUG=true
